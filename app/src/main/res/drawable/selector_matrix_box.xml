<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Estado FOCUSED: Verde neón semi-transparente (50% de opacidad #8000FF41) con borde brillante -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#8000FF41" />
            <stroke android:width="3dp" android:color="#FFFFFF" />
            <corners android:radius="3dp" />
        </shape>
    </item>

    <!-- Estado NORMAL -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC0D0208" />
            <stroke android:width="1dp" android:color="#008F11" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</selector>