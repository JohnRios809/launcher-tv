<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Cuando tiene el foco del D-pad (resaltado) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1F355E" />
            <stroke android:width="3dp" android:color="#FFB000" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <!-- Estado normal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0D1526" />
            <stroke android:width="1dp" android:color="#FFB000" android:alpha="0.3" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</selector>